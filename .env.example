# --- Pflicht ---------------------------------------------------------------
# Kostenloser Key aus Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# --- Modell ----------------------------------------------------------------
# Standard ist gemini-3.8-flash: im Free Tier kostenlos und für
# Kalorienschätzungen ausreichend. Alternativen (ebenfalls kostenlos, weniger
# Andrang als das neueste Modell):
#   gemini-3.5-flash-lite – schnellstes Modell, großzügigstes Tageslimit
#   gemini-3.6-flash      – Vorgängermodell
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# Ist das Modell überlastet (im Free Tier zu Stoßzeiten häufig, Fehler 503)
# oder am Limit, weicht die App der Reihe nach auf diese Modelle aus:
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
#
# Die App setzt die Denkstufe des Modells selbst auf niedrig, damit die
# Antworten schnell kommen. Lehnt ein Modell den Parameter ab, fällt sie
# automatisch darauf zurück, ihn wegzulassen. Zum Erzwingen:
# AI_THINKING=off

# --- Claude für Admin-Konten (optional) ------------------------------------
# Adressen in ADMIN_EMAILS sehen in den Einstellungen das Feld „KI-Modell“
# und können dort für ihr eigenes Konto Claude Opus 5.5 wählen. Alle anderen
# Konten nutzen immer Gemini – der Server prüft das bei jeder Anfrage.
# ADMIN_EMAILS=du@example.com
#
# Key von https://platform.claude.com (Guthaben nötig, kein Free Tier).
# Ohne Key bleibt Claude in der Auswahl gesperrt.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Denktiefe von Claude: low | medium | high. medium ist der Standard,
# low antwortet schneller und kostet weniger.
# AI_CLAUDE_EFFORT=medium

# --- Zeitzone --------------------------------------------------------------
# Bestimmt Datum und Uhrzeit der Einträge (inkl. Sommerzeit).
APP_TZ=Europe/Berlin

# --- Registrierung ---------------------------------------------------------
# Standard: Es darf sich nur das ERSTE Konto anlegen – das deine. Danach ist
# die Registrierung zu, damit auf einer öffentlich erreichbaren Adresse keine
# Fremden Konten anlegen und deine API-Kosten verursachen.
#
# Weitere Personen freischalten (Kommaliste, deine Adresse mit aufführen):
# ALLOWED_EMAILS=du@example.com,partnerin@example.com
#
# Oder für alle öffnen (nur mit Zugriffsschutz davor sinnvoll,
# z. B. Cloudflare Access):
# REGISTRATION_OPEN=true

# --- Sessions --------------------------------------------------------------
# Ohne Angabe wird beim ersten Start automatisch ein Schlüssel unter
# data/secret_key erzeugt. Wird er gesetzt oder geändert, sind alle
# bestehenden Anmeldungen ungültig.
# SECRET_KEY=
#
# Leer lassen: Das Secure-Flag am Session-Cookie wird dann automatisch
# gesetzt, wenn die Seite über HTTPS aufgerufen wird. Nur überschreiben,
# wenn du weißt, warum.
# COOKIE_SECURE=true

# --- E-Mail-Versand der Anmeldecodes ---------------------------------------
# Ohne SMTP-Angaben landet der Code im Container-Log:
#   docker compose logs kalorien-tagebuch
#
# Beispiel Gmail (App-Passwort nötig, nicht das normale Passwort – siehe
# myaccount.google.com/apppasswords). Bei den meisten Anbietern muss
# SMTP_FROM dieselbe Adresse wie SMTP_USER sein.
# SMTP_HOST=smtp.gmail.com
# SMTP_SECURITY=starttls   # starttls (Port 587) | ssl (Port 465) | none
# SMTP_PORT=587            # weglassen = passend zu SMTP_SECURITY
# SMTP_USER=du@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=du@gmail.com
