# --- Pflicht ---------------------------------------------------------------
# Kostenloser Key aus Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# --- Modell ----------------------------------------------------------------
# Standard ist gemini-3.8-flash: im Free Tier kostenlos und für
# Kalorienschätzungen ausreichend. Alternativen (ebenfalls kostenlos):
#   gemini-2.5-flash-lite – schnellstes Modell, großzügigstes Tageslimit
#   gemini-2.5-flash      – bewährtes Vorgängermodell
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Zeitzone --------------------------------------------------------------
# Bestimmt Datum und Uhrzeit der Einträge (inkl. Sommerzeit).
APP_TZ=Europe/Berlin

# --- Registrierung ---------------------------------------------------------
# Standard: Es darf sich nur das ERSTE Konto anlegen – das deine. Danach ist
# die Registrierung zu, damit auf einer öffentlich erreichbaren Adresse keine
# Fremden Konten anlegen und deine API-Kosten verursachen.
#
# Weitere Personen freischalten (Kommaliste, deine Adresse mit aufführen):
# ALLOWED_EMAILS=du@example.com,partnerin@example.com
#
# Oder für alle öffnen (nur mit Zugriffsschutz davor sinnvoll,
# z. B. Cloudflare Access):
# REGISTRATION_OPEN=true

# --- Sessions --------------------------------------------------------------
# Ohne Angabe wird beim ersten Start automatisch ein Schlüssel unter
# data/secret_key erzeugt. Wird er gesetzt oder geändert, sind alle
# bestehenden Anmeldungen ungültig.
# SECRET_KEY=
#
# Leer lassen: Das Secure-Flag am Session-Cookie wird dann automatisch
# gesetzt, wenn die Seite über HTTPS aufgerufen wird. Nur überschreiben,
# wenn du weißt, warum.
# COOKIE_SECURE=true

# --- E-Mail-Versand der Anmeldecodes ---------------------------------------
# Ohne SMTP-Angaben landet der Code im Container-Log:
#   docker compose logs kalorien-tagebuch
#
# Beispiel Gmail (App-Passwort nötig, nicht das normale Passwort – siehe
# myaccount.google.com/apppasswords). Bei den meisten Anbietern muss
# SMTP_FROM dieselbe Adresse wie SMTP_USER sein.
# SMTP_HOST=smtp.gmail.com
# SMTP_SECURITY=starttls   # starttls (Port 587) | ssl (Port 465) | none
# SMTP_PORT=587            # weglassen = passend zu SMTP_SECURITY
# SMTP_USER=du@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=du@gmail.com
